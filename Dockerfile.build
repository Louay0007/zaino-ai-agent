# Zaino AI Agent — Linux container build (Tauri → AppImage + deb).
#
# Produces: dist-artifacts/zaino-ai-agent_1.0.1_amd64.{AppImage,deb}
#
# Usage:
#   docker build -f Dockerfile.build -t zaino-ai-agent:build .
#   docker create --name zaino-out zaino-ai-agent:build
#   docker cp zaino-out:/app/dist-artifacts ./dist-artifacts
#   docker rm zaino-out
#
# Notes:
# - Ubuntu 24.04 matches the release.yml linux runner (webkit2gtk-4.1).
# - Unsigned build: no updater keys needed; the app runs standalone.
# - The bundle step uses the same prune script as CI for Wayland libs.

FROM ubuntu:24.04 AS build

ENV DEBIAN_FRONTEND=noninteractive \
    NODE_OPTIONS="--max-old-space-size=8192"

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git \
    cmake build-essential pkg-config \
    libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev \
    librsvg2-dev patchelf libfuse2 xdg-utils \
    libasound2-dev libpipewire-0.3-dev libgbm-dev \
    libssl-dev libsqlite3-dev \
    python3 file \
 && rm -rf /var/lib/apt/lists/*

# Node 20 + pnpm 10 (matches release.yml + packageManager pin)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/* \
 && corepack enable && corepack prepare pnpm@10.29.3 --activate

# Rust stable
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal \
 && . "$HOME/.cargo/env" && rustc --version
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /app

# Dependency layers first for cache reuse
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages ./packages
RUN pnpm install --frozen-lockfile --ignore-scripts

# Full source
COPY . .

# Frontend
RUN pnpm exec tsc --noEmit && pnpm exec vite build

# Rust backend (compile once, bundle after)
RUN pnpm exec tauri build --no-bundle

# Bundles: AppImage + deb (unsigned — standalone use)
RUN pnpm exec tauri bundle --bundles appimage deb

# Prune bundled Wayland libs (same script as CI), tolerate absence
RUN node scripts/prune-appimage-wayland-libs.mjs \
      --appimage "$(find src-tauri/target/release/bundle/appimage -maxdepth 1 -name '*.AppImage' | head -n 1)" \
      --arch x86_64 || true

# Collect with Zaino names
RUN mkdir -p /app/dist-artifacts \
 && VERSION="$(python3 -c "import json;print(json.load(open('src-tauri/tauri.conf.json'))['version'])")" \
 && for f in src-tauri/target/release/bundle/appimage/*.AppImage; do \
      cp "$f" "/app/dist-artifacts/zaino-ai-agent_${VERSION}_amd64.AppImage"; \
    done \
 && for f in src-tauri/target/release/bundle/deb/*.deb; do \
      cp "$f" "/app/dist-artifacts/zaino-ai-agent_${VERSION}_amd64.deb"; \
    done \
 && ls -la /app/dist-artifacts/

# Output-only image
FROM scratch AS artifacts
COPY --from=build /app/dist-artifacts /dist-artifacts
